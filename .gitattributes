# Normalize line endings in the repository to LF, and let Git check out the
# platform-native form. Without this, committing from Windows and from
# macOS/Linux produces whole-file diffs on the same content.
* text=auto eol=lf

# Binary assets: never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.webm binary

# Generated: collapsed in GitHub reviews, but still diffable locally so
# dependency changes can be read.
package-lock.json linguist-generated=true
