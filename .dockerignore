# The only image built from this context is the server (apps/server/Dockerfile).
# Everything it does not read stays out, so the context is small and no local
# secret or build output can leak into a layer.
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo
**/coverage
**/*.log
.git
.github
.env
.env.*
!.env.example
*.pem
*.key

# Docs, design and tooling.
docs
*.md
.agents
.claude
.codex
.impeccable
uploads
scripts

# The frontend: only its manifest, which `npm ci` checks against the lockfile.
apps/frontend/*
!apps/frontend/package.json

# Server files the image never reads.
apps/server/**/*.test.ts
apps/server/Dockerfile
