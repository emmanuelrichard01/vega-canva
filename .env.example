# Copy to `.env` beside docker-compose.prod.yml and fill in. Never commit it.
#
# The server refuses to start in production if any of these is missing, or if a
# secret is left as one of the development defaults published in this
# repository. That refusal is deliberate: a server that will not boot is a page
# somebody fixes in five minutes, and one that boots on a known password is an
# incident nobody notices.

# --- Database -------------------------------------------------------------
POSTGRES_USER=vega
POSTGRES_PASSWORD=          # generate: openssl rand -base64 32
POSTGRES_DB=vega_canva

# --- Object storage -------------------------------------------------------
S3_BUCKET=vega-canva-media
S3_ACCESS_KEY=              # generate: openssl rand -hex 16
S3_SECRET_KEY=              # generate: openssl rand -base64 32

# --- Public surface -------------------------------------------------------
# Comma separated. The sites allowed to call this API from a browser.
ALLOWED_ORIGINS=https://app.example.com

# How a browser reaches this API. Stored in documents as the address of
# uploaded media, so it must be the public URL and must not change casually --
# boards written before a change will still hold the old one.
PUBLIC_API_URL=https://api.example.com

# Reverse proxies in front of this server. `1` for a single nginx or load
# balancer. Wrong values break rate limiting and the per-address upload quota:
# too low and every client shares one bucket, too high and any client can
# forge its own address.
TRUST_PROXY=1

# Signs anonymous session tokens (the durable guest identity). Required in
# production: at least 32 characters, different from SHARE_SECRET and
# AUTH_SECRET. Rotating it gives every visitor a new identity.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Bind address for the published port. Leave as loopback when a reverse proxy
# on the same host is terminating TLS.
SERVER_BIND=127.0.0.1

# --- Optional -------------------------------------------------------------
# One shared token for the whole deployment. A front door for a private
# instance, not authorization -- it cannot express "this person, this board".
AUTH_SECRET=

# Signs invite links, so a shared "view only" link carries a role this server
# decided rather than one the client asked for. Absent is supported: without
# it the share dialog offers full-access links only and says why, which is
# better than offering a restriction that cannot be enforced.
#
# Generate one and keep it: `openssl rand -base64 32`. Changing it invalidates
# every invite link already handed out, which is the only revocation this
# scheme has -- and it is all-or-nothing.
SHARE_SECRET=

# Opens the /admin routes (POST /admin/reap, GET /admin/stats) and lets its
# holder mint invites of any role. Unset means those routes refuse every
# request. The scheduled reap does not need it -- it runs the script.
ADMIN_SECRET=

# When true, a bare room id opens nothing. Every WebSocket connection and REST
# call needs a signed invite (REST calls send it as `X-Invite-Token`), and an
# invite can only mint invites at or below its own role. Breaks every bare room
# link already shared. Default false: the room id is the capability.
ENFORCE_SHARE_TOKENS=false

# The shortest room id this server will serve. The access model rests on room
# ids being unguessable; this floor is what stops a hand-typed URL creating a
# board anybody can find. Lower it only to keep older short-id boards reachable.
MIN_ROOM_ID_LENGTH=8

# Storage quotas to prevent anonymous upload abuse (bytes). The daily cap is
# charged to the client address and to the session, and the stricter decides.
# Link-preview pictures count against it too. Uploads stop at the global
# ceiling, and error tracking is told from 90% on.
MAX_ROOM_STORAGE_BYTES=209715200       # 200MB per room
MAX_IP_DAILY_STORAGE_BYTES=524288000   # 500MB per address (and per session) daily
MAX_GLOBAL_STORAGE_BYTES=10737418240   # 10GB global ceiling

# Collaboration socket limits.
WS_MAX_PAYLOAD_BYTES=4194304           # 4MB: largest single WebSocket frame
MAX_DOCUMENT_BYTES=33554432            # 32MB: updates past this are refused
WS_MAX_CONNECTIONS_PER_IP=32           # open sockets per client address
ROOM_CREATE_BURST=30                   # new boards per address: a burst...
ROOM_CREATE_PER_MINUTE=6               # ...then this many a minute

# Room inactivity retention in days before reaper eligibility.
ROOM_TTL_DAYS=90

# How long history may buffer before being written, in milliseconds. A hard
# kill loses at most this much scrubbable history; a graceful stop loses none.
HISTORY_FLUSH_MS=1000
HISTORY_MAX_BYTES=67108864             # 64MB of buffered history, then the oldest is dropped

# Shared Redis, for more than one instance. Either a URL (rediss:// for TLS)
# or host/port with an optional password.
#   REDIS_URL=rediss://default:password@cache.example.com:6380
#   REDIS_HOST=redis
#   REDIS_PORT=6379
#   REDIS_PASSWORD=
#   REDIS_TLS=false

# Error tracking. Optional, but a deployment without it is a deployment that
# finds out about faults from the person who hit one. `/readyz` reports
# `errorTracking` from whether the SDK actually initialised -- trust that
# field rather than the startup log line.
SENTRY_DSN=

# --- Frontend -------------------------------------------------------------
# These are read at *build* time by Vite and inlined into the bundle, so they
# belong wherever the frontend is built (Vercel's project settings), not here.
# Listed for completeness, because every one of them is a way to ship a build
# that points at nothing and fails only in the browser.
#
#   VITE_API_URL=https://api.example.com
#   VITE_WS_URL=wss://api.example.com
#
# The browser DSN. Public by design -- it accepts events and grants nothing --
# but inlined at build time, so rotating it needs a rebuild, not an env change.
#
#   VITE_SENTRY_DSN=
#
# Must match AUTH_SECRET above, or every client of a deployment that sets one
# is refused with "Unauthorized room connection". Set both, or neither.
#
#   VITE_AUTH_SECRET=
#
# Spotify in the music player (optional). A Spotify app's client ID; there is
# no secret, because sign-in uses PKCE in the browser. Unset hides nothing --
# the player just explains Spotify isn't set up. See docs/DEPLOYMENT.md §9.
#
#   VITE_SPOTIFY_CLIENT_ID=
#   VITE_SPOTIFY_REDIRECT_URI=   (defaults to <origin>/spotify-callback)
