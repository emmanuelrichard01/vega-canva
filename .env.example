# Copy to `.env` beside docker-compose.prod.yml and fill in. Never commit it.
#
# The server refuses to start in production if any of these is missing, or if a
# secret is left as one of the development defaults published in this
# repository. That refusal is deliberate: a server that will not boot is a page
# somebody fixes in five minutes, and one that boots on a known password is an
# incident nobody notices.

# --- Database -------------------------------------------------------------
POSTGRES_USER=vega
POSTGRES_PASSWORD=          # generate: openssl rand -base64 32
POSTGRES_DB=vega_canva

# --- Object storage -------------------------------------------------------
S3_BUCKET=vega-canva-media
S3_ACCESS_KEY=              # generate: openssl rand -hex 16
S3_SECRET_KEY=              # generate: openssl rand -base64 32

# --- Public surface -------------------------------------------------------
# Comma separated. The sites allowed to call this API from a browser.
ALLOWED_ORIGINS=https://app.example.com

# How a browser reaches this API. Stored in documents as the address of
# uploaded media, so it must be the public URL and must not change casually --
# boards written before a change will still hold the old one.
PUBLIC_API_URL=https://api.example.com

# Reverse proxies in front of this server. `1` for a single nginx or load
# balancer. Wrong values break rate limiting: too low and every client shares
# one bucket, too high and any client can forge its own address.
TRUST_PROXY=1

# Bind address for the published port. Leave as loopback when a reverse proxy
# on the same host is terminating TLS.
SERVER_BIND=127.0.0.1

# --- Optional -------------------------------------------------------------
# One shared token for the whole deployment. A front door for a private
# instance, not authorization -- it cannot express "this person, this board".
AUTH_SECRET=

# The shortest room id this server will serve. The access model rests on room
# ids being unguessable; this floor is what stops a hand-typed URL creating a
# board anybody can find. Lower it only to keep older short-id boards reachable.
MIN_ROOM_ID_LENGTH=8

# How long history may buffer before being written, in milliseconds. A hard
# kill loses at most this much scrubbable history; a graceful stop loses none.
HISTORY_FLUSH_MS=1000

# Error tracking. Optional, but a deployment without it is a deployment that
# finds out about faults from the person who hit one. `/readyz` reports
# `errorTracking` from whether the SDK actually initialised -- trust that
# field rather than the startup log line.
SENTRY_DSN=

# --- Frontend -------------------------------------------------------------
# These are read at *build* time by Vite and inlined into the bundle, so they
# belong wherever the frontend is built (Vercel's project settings), not here.
# Listed for completeness, because every one of them is a way to ship a build
# that points at nothing and fails only in the browser.
#
#   VITE_API_URL=https://api.example.com
#   VITE_WS_URL=wss://api.example.com
#
# The browser DSN. Public by design -- it accepts events and grants nothing --
# but inlined at build time, so rotating it needs a rebuild, not an env change.
#
#   VITE_SENTRY_DSN=
#
# Must match AUTH_SECRET above, or every client of a deployment that sets one
# is refused with "Unauthorized room connection". Set both, or neither.
#
#   VITE_AUTH_SECRET=
